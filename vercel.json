{
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/", "destination": "/login.html", "permanent": false },
    { "source": "/index.html", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/api/app" }
  ]
}
