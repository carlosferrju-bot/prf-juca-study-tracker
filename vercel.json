{
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/", "destination": "/login.html", "permanent": false },
    { "source": "/index.html", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/api/app-ai" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</forensic-neon.css>; rel=\"stylesheet\""
        }
      ]
    }
  ]
}
